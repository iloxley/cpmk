{
  "name": "cpmk",
  "version": "0.9.0",
  "description": "Local-first project memory and bounded context for AI coding tools",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "cpmk": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schemas",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "format": "prettier --write src test scripts schemas package.json tsconfig.json tsconfig.build.json vitest.config.ts eslint.config.js",
    "format:check": "prettier --check src test scripts schemas package.json tsconfig.json tsconfig.build.json vitest.config.ts eslint.config.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "tsc -p tsconfig.build.json",
    "pack:smoke": "node scripts/pack-smoke.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm run test:coverage && npm run pack:smoke"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iloxley/cpmk.git"
  },
  "keywords": [
    "cpmk",
    "project-memory",
    "cli",
    "context"
  ],
  "dependencies": {
    "ajv": "^8.17.1",
    "ulidx": "^2.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.17.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vitest": "^3.2.4"
  }
}
