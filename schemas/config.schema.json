{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/cpmk/cpmk/main/schemas/config.schema.json",
  "title": "CPMK config",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "context", "privacy"],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": 1
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultBudget"],
      "properties": {
        "defaultBudget": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["denyGlobs"],
      "properties": {
        "denyGlobs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
