{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/cpmk/cpmk/main/schemas/memory-entry.schema.json",
  "title": "CPMK memory entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "type",
    "title",
    "content",
    "tags",
    "createdAt",
    "updatedAt",
    "source",
    "status"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9A-Z]{26}$"
    },
    "type": {
      "type": "string",
      "enum": ["fact", "decision", "convention", "task", "handoff", "warning"]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "content": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
      }
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": ["manual", "import", "system"]
    },
    "status": {
      "type": "string",
      "enum": ["active", "superseded", "archived"]
    }
  }
}
